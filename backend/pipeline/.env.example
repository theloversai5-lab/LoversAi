# Copy these settings into the backend environment. Never commit credentials.
WEDDING_PIPELINE_ENABLED=false
# Isolated loopback development server port. Supports --port=<number> override.
WEDDING_PIPELINE_PORT=5000
# For configured database mode only; --local-db owns its separate local instance.
# Never put credentials in this example.
MONGO_URI=
# Required with MONGO_URI; --local-db generates its own private signing secret.
# Never copy a production database/secret into local development.
JWT_SECRET=
GEMINI_API_KEY=
# Explicit model selection, no silent alternate provider or model fallback.
# Check availability for your account before running paid jobs.
WEDDING_GEMINI_IMAGE_MODEL=
WEDDING_GEMINI_VISION_MODEL=
# Optional fal.ai key for element_view provider "fal" (Qwen multiple-angles). Missing key -> 503, no Gemini fallback.
FAL_KEY=
# Default element_view provider when a job omits it: gemini (default) or fal.
WEDDING_ANGLES_PROVIDER=gemini
# Executable path, not a shell command. Python must have pipeline/requirements.txt.
WEDDING_PIPELINE_PYTHON=python
# Optional native COLMAP executable path (no .bat/.cmd wrapper, shell commands or downloads).
# Required only for calibrated sparse/dense photogrammetry; dense stereo needs compatible hardware.
WEDDING_PIPELINE_COLMAP=
# Local executable paths, never shell commands. Required for manual Flow MP4 import.
WEDDING_PIPELINE_FFMPEG=ffmpeg
WEDDING_PIPELINE_FFPROBE=ffprobe
# Optional absolute private volume path. Default: backend/.pipeline-data.
# Must never be placed under uploads/, public/, or a web-server static root.
WEDDING_PIPELINE_DATA_DIR=

# ---- AI provider switch ----
# WEDDING_AI_PROVIDER=gemini|openai switches image generation AND vision (screening, QA, layout, specs).
# Optional per-role overrides: WEDDING_IMAGE_PROVIDER / WEDDING_VISION_PROVIDER.
WEDDING_AI_PROVIDER=gemini
WEDDING_IMAGE_PROVIDER=
WEDDING_VISION_PROVIDER=
# OpenAI (used when a role above is set to openai). Never commit the key.
WEDDING_OPENAI_API_KEY=
WEDDING_OPENAI_IMAGE_MODEL=gpt-image-1
WEDDING_OPENAI_VISION_MODEL=gpt-4.1-mini
# low | medium | high | auto (cost/quality)
WEDDING_OPENAI_IMAGE_QUALITY=medium
# high keeps reference images (venue, decor) closer; leave empty if the model rejects it.
WEDDING_OPENAI_INPUT_FIDELITY=high
