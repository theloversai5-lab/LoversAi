# Example production environment variables for deployment
PORT=5000
NODE_ENV=production

# MongoDB (placeholder)
MONGO_URI=your_mongo_connection_string_here

# Cloudinary placeholders - set real values in your secrets manager or CI
CLOUDINARY_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# Optional one-time admin seed when no admin exists (12+ char password). Never commit real values.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
# Dev-only credit debug routes; ignored when NODE_ENV=production.
ENABLE_DEBUG_ROUTES=false
